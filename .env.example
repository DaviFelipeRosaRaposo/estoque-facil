# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API). Nunca envie o .env.local para o GitHub.

# Públicas por design (vão para o navegador)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# SECRETA (só no servidor; na Vercel, em Settings > Environment Variables).
# Connection string do Supabase: botão "Connect" > Transaction pooler (porta 6543).
# Não use prefixo NEXT_PUBLIC_ aqui.
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
